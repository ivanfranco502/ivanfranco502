---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const entry = await getEntry('pages', 'now');
if (!entry) throw new Error('Missing src/content/pages/now.md');
const { Content } = await render(entry);
const updated = entry.data.updatedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="Now" description="What Ivan Franco is currently focused on.">
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-16 fade-in">
    <SectionHeading eyebrow={`Updated ${updated}`} title="Now" />
    <article class="prose prose-neutral max-w-none text-[color:var(--color-fg)] leading-relaxed
      [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:mt-8 [&_h2]:mb-3 [&_h2]:tracking-tight
      [&_p]:my-4 [&_p]:text-[color:var(--color-muted)]
      [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:text-[color:var(--color-muted)] [&_li]:my-1
      [&_a]:text-[color:var(--color-accent-from)] [&_a:hover]:underline
      [&_hr]:my-8 [&_hr]:border-[color:var(--color-subtle)]
      [&_em]:text-[color:var(--color-muted)]">
      <Content />
    </article>
  </section>
</BaseLayout>
