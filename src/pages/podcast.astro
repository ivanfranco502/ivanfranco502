---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PodcastLinks from '../components/PodcastLinks.astro';
import EpisodeCard from '../components/EpisodeCard.astro';

const podcastEntries = await getCollection('podcast');
const show = podcastEntries.find(p => p.id === 'matebreak') ?? podcastEntries[0];

const episodes = (await getCollection('episodes'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout
  title={show?.data.name ?? 'Podcast'}
  description={show?.data.description}
>
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-16 fade-in">
    <SectionHeading eyebrow="Podcast" title={show?.data.name ?? 'Podcast'} />
    {show && (
      <>
        <p class="text-xl text-[color:var(--color-fg)] mb-3 max-w-2xl">{show.data.tagline}</p>
        <p class="text-[color:var(--color-muted)] mb-8 max-w-2xl leading-relaxed">{show.data.description}</p>

        <div class="mb-10">
          <h3 class="text-sm uppercase tracking-widest text-[color:var(--color-muted)] mb-3">Listen on</h3>
          <PodcastLinks platforms={show.data.platforms} />
        </div>

        {show.data.spotifyShowId && (
          <div class="rounded-xl overflow-hidden border border-[color:var(--color-subtle)] mb-12">
            <iframe
              src={`https://open.spotify.com/embed/show/${show.data.spotifyShowId}?theme=0`}
              width="100%"
              height="232"
              style="border: 0"
              allow="encrypted-media"
              title={`${show.data.name} on Spotify`}
              loading="lazy"
            ></iframe>
          </div>
        )}
      </>
    )}

    {episodes.length > 0 && (
      <div>
        <h3 class="text-sm uppercase tracking-widest text-[color:var(--color-muted)] mb-4">
          All episodes ({episodes.length})
        </h3>
        <div class="grid gap-3">
          {episodes.map(episode => <EpisodeCard episode={episode} />)}
        </div>
      </div>
    )}
  </section>
</BaseLayout>
