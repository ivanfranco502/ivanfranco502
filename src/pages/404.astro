---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="Page not found.">
  <section class="max-w-3xl mx-auto px-6 py-24 text-center fade-in">
    <p class="text-sm uppercase tracking-widest text-[color:var(--color-muted)] mb-4">404</p>
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">
      <span class="gradient-text">Lost in the mate fields 🧉. </span>
    </h1>
    <p class="text-[color:var(--color-muted)] mb-8 max-w-md mx-auto">
      That page doesn't exist (yet). Head back home and try again.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[color:var(--color-fg)] text-[color:var(--color-bg)] font-medium hover:opacity-90 transition-opacity"
    >
      ← Back home
    </a>
  </section>
</BaseLayout>
