---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { writingProfiles } from '../data/site';
import { Icon } from 'astro-icon/components';

const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout title="Writing" description="Articles and notes by Ivan Franco — published on Collected Notes and Medium.">
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-12 fade-in">
    <SectionHeading eyebrow="Notes" title="Writing" />
    <p class="text-[color:var(--color-muted)] -mt-3 mb-8 max-w-2xl">
      I write about software, the work, and things I'm learning. New pieces show up first on Collected Notes; many get cross-posted to Medium.
    </p>

    <div class="grid sm:grid-cols-2 gap-3 mb-10">
      {writingProfiles.map(p => (
        <a
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group p-5 rounded-xl border border-[color:var(--color-subtle)] hover:border-[color:var(--color-fg)]/30 hover:-translate-y-1 hover:shadow-lg transition-all flex items-start gap-3"
        >
          <Icon name={p.icon} class="size-5 mt-0.5 text-[color:var(--color-muted)] group-hover:text-[color:var(--color-fg)] transition-colors" />
          <div>
            <p class="font-medium tracking-tight group-hover:text-[color:var(--color-accent-from)] transition-colors">
              {p.platform}
              <Icon name="lucide:arrow-up-right" class="inline-block size-3.5 ml-0.5" />
            </p>
            <p class="text-sm text-[color:var(--color-muted)] mt-1">{p.description}</p>
          </div>
        </a>
      ))}
    </div>

    {articles.length > 0 && (
      <>
        <h3 class="text-sm uppercase tracking-widest text-[color:var(--color-muted)] mb-4">Highlights</h3>
        <div class="grid gap-3">
          {articles.map(article => <ArticleCard article={article} />)}
        </div>
      </>
    )}
  </section>
</BaseLayout>
